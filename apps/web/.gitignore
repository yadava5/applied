# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# pnpm is this app's package manager and pnpm-lock.yaml is the tracked lockfile.
# An `npm install` run here — by a person or an agent reaching for the habitual
# command — writes a package-lock.json that was neither tracked nor ignored, so
# it sat in `git status` as a permanent stray and made `npm ci` impossible
# (it needs a lockfile it can trust, and this one describes a different
# resolution than pnpm's). Two separate agents tripped over it in one evening.
# Scoped to this app on purpose: booklet/package-lock.json is tracked and real.
/package-lock.json
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/playwright-report/
/test-results/
/playwright/.cache/
