# Supabase project URL (e.g. https://xxxx.supabase.co).
# Safe to expose — used by the browser SDK to hit the Supabase REST and
# realtime endpoints.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key. Safe to expose — RLS policies on the
# backend enforce per-user access. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL of the FastAPI backend the web app will proxy API calls to.
# Example (local dev): http://localhost:8000
# Example (prod):      https://jobtracker.vercel.app
BACKEND_API_URL=

# Optional: service-role key. Server-side admin tasks only — never leak this
# to the browser.
#
# "Optional" means the app boots without it, NOT that nothing depends on it:
# Settings -> Delete account calls `auth.admin.deleteUser`, which needs this
# key, and returns 501 on any deployment that does not have it. The UI reads
# the same capability and says so up front, and `GET /api/account/delete`
# reports `{ "deletionEnabled": <bool> }`. Vercel injects env at deploy time,
# so setting it on an existing project needs a redeploy to take effect.
# SUPABASE_SERVICE_ROLE_KEY=

# Gmail connection (/settings, /inbox): NO extra web env is required — the
# web app reaches the backend's Gmail OAuth endpoints via BACKEND_API_URL.
# The Google client id/secret + redirect URI live on the BACKEND (API)
# project only. See DEPLOY.md "Path C — real Gmail connection".
