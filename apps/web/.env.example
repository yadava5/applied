# Supabase project URL (e.g. https://xxxx.supabase.co).
# Safe to expose — used by the browser SDK to hit the Supabase REST and
# realtime endpoints.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key. Safe to expose — RLS policies on the
# backend enforce per-user access. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL of the FastAPI backend the web app will proxy API calls to.
# Example (local dev): http://localhost:8000
# Example (prod):      https://jobtracker.vercel.app
BACKEND_API_URL=

# Optional: service-role key. Only set this for server-side admin tasks
# (cron jobs, migration scripts). Never leak this to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
