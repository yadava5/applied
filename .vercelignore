# The Python function needs backend/jobtracker (2.2 MB) — nothing else.
# Without these excludes the backend tree is ~880 MB and the function
# build exceeds Vercel's 250 MB unzipped limit.
backend/build
backend/dist
backend/checkpoints
backend/data
backend/tests
backend/.venv
backend/.venv311
backend/.pytest_cache
backend/.ruff_cache
# NOTE: this file is read from the repository root for *every* Vercel project
# built from this repo, whatever its Root Directory. A blanket `apps` entry
# therefore deleted apps/web before the jobtracker-web build could run, and
# every push-triggered web build failed with NEXT_NO_VERSION. Exclude only the
# subtrees that are genuinely dead weight: apps/macos is 19.7 MB of Xcode
# project and image assets, apps/web is 2 MB and is the deployed web app.
apps/macos
apps/mobile
dist
docs
ml
scripts
