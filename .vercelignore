# build exceeds Vercel's 250 MB unzipped limit.
backend/build
backend/dist
backend/checkpoints
backend/data
backend/tests
backend/.venv
backend/.venv311
backend/.pytest_cache
backend/.ruff_cache
apps
dist
docs
ml
scripts
